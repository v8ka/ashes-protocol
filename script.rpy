# =====================================================================
#  ميثاق الرماد: بروتوكول الصفر  (Ashes Protocol: Zero)
#  ملف Ren'Py الرئيسي — script.rpy
#  الأسماء المعدلة: كاي -> سامي | المارشال آرثر -> المارشال محمد
#                   الظل -> (يُكشف اسمه لاحقاً: محمود) | البروفيسور زياد -> البروفيسور أحمد
# =====================================================================
# ملاحظة للعربية: ضع خطاً عربياً (مثل Cairo.ttf أو Amiri) في مجلد game/fonts
# ثم فعّل الأسطر التالية في ملف gui.rpy أو هنا:
#   define gui.text_font = "fonts/Cairo-Regular.ttf"
#   define gui.name_text_font = "fonts/Cairo-Regular.ttf"
#   define gui.interface_text_font = "fonts/Cairo-Regular.ttf"
#   define gui.choice_button_text_font = "fonts/Cairo-Regular.ttf"
#   define gui.language = "unicode"

# ---------------------------------------------------------------------
# المتغيرات
# ---------------------------------------------------------------------
default humanity = 50
default madness = 0
default sara_trust = 50
default loop_count = 1

default shadow_name = "الظل"          # يتحول إلى «محمود» بعد الكشف
default shadow_revealed = False

# مصائر الشخصيات (True = حي)
default alive_sara = True
default alive_silvio = True
default alive_lena = True
default alive_ryan = True
default alive_ahmad = True
default alive_mohammed = True
default alive_cyrene = True

# أعلام القرارات
default obeyed_marshal = False
default fled_with_sara = False
default oxygen_to_children = False
default oxygen_to_labs = False
default sara_memory_wiped = False
default sara_left_to_die = False
default allied_shadow = False
default allied_ryan = False
default hacked_elena = False
default destroyed_manually = False
default refused_sacrifice = False

# ---------------------------------------------------------------------
# الشخصيات
# ---------------------------------------------------------------------
define sami = Character("سامي", color="#7fd6ff")
define sara = Character("سارة", color="#ffb3d1")
define mohammed = Character("المارشال محمد", color="#ff8a5c")
define victor = Character("الجنرال ڤيكتور", color="#c0c0c0")
define cyrene = Character("الكابتن سيرين", color="#a8e6a1")
define silvio = Character("سيلفيو", color="#ffe08a")
define elena = Character("إيلينا (الذكاء الاصطناعي)", color="#9ad0ff")
define aurelian = Character("الوزير أوريليان", color="#b0b0b0")
define ryan = Character("ريان", color="#ff7070")
define lena = Character("لينا", color="#ffd1f0")
define ahmad = Character("البروفيسور أحمد", color="#d3c28a")
define valerian = Character("د. فاليريان", color="#c9a0ff")
define shadow = Character("[shadow_name]", color="#8b0000")
define whisper = Character("صوت في رأسك", color="#555555", what_italic=True)
define sys_msg = Character(None, what_color="#ff4040", what_bold=True)

# ---------------------------------------------------------------------
# التأثيرات البصرية (ارتقاء الذكريات)
# ---------------------------------------------------------------------
transform shake_light:
    linear 0.05 xoffset 4
    linear 0.05 xoffset -4
    linear 0.05 xoffset 3
    linear 0.05 xoffset 0

transform shake_heavy:
    linear 0.03 xoffset 12 yoffset 6
    linear 0.03 xoffset -12 yoffset -6
    linear 0.03 xoffset 9 yoffset 4
    linear 0.03 xoffset -9 yoffset -4
    repeat 6

transform flicker:
    alpha 1.0
    linear 0.1 alpha 0.3
    linear 0.1 alpha 1.0
    linear 0.2 alpha 0.5
    linear 0.1 alpha 1.0

image bg dome_command = Solid("#10141f")
image bg red_alarm = Solid("#3a0a0a")
image bg residential = Solid("#1b2a2f")
image bg wasteland = Solid("#3b3326")
image bg reactor = Solid("#0b0b1a")
image bg black = Solid("#000000")
image crack_overlay = Solid("#00000066")

# ---------------------------------------------------------------------
# دالة ارتقاء الذكريات: تعرض تأثيراً حسب مستوى الجنون
# ---------------------------------------------------------------------
label memory_bleed:
    if madness >= 70:
        show crack_overlay at shake_heavy
        with vpunch
        whisper "لماذا تركتنا نموت يا سامي؟ لماذا؟"
        whisper "الحلقة الثالثة... كنتُ أنادي عليك وأنت تحدق في الجدار."
        sami "(يضغط على رأسه) اخرسوا... اخرسوا جميعاً!"
        sami "(الشقوق السوداء تمتد على ذراعه حتى الكتف، والنيون ينبض تحتها كعروق ميتة.)"
        hide crack_overlay
    elif madness >= 40:
        show crack_overlay at flicker
        with hpunch
        whisper "الدخان... رائحة اللحم المحترق... ألا تتذكرها؟"
        sami "(يغمض عينيه بقوة) ليست حقيقية... مجرد صدى من حلقة سابقة."
        hide crack_overlay
    elif madness >= 15:
        show crack_overlay at shake_light
        whisper "...سامي..."
        sami "(طنين خافت في أذنيه، وخيط نيون أسود يلمع لحظة تحت جلد معصمه.)"
        hide crack_overlay
    else:
        sami "(صداع خفيف... ربما مجرد إرهاق.)"
    return

# =====================================================================
#  البداية
# =====================================================================
label start:
    scene bg black
    with fade

    centered "{size=+10}ميثاق الرماد: بروتوكول الصفر{/size}"
    centered "القبة رقم 9 — آخر معاقل البشرية.\nالمفاعل الكوانتي ينفجر كل ثلاثين يوماً.\nوهناك رجل واحد يتذكر كل مرة."

    jump act1

# =====================================================================
#  الفصل الأول: صدى الصدمة الأولى
# =====================================================================
label act1:
    scene bg red_alarm
    with Dissolve(1.0)

    sys_msg "⚠ إنذار أحمر — انصهار المفاعل المركزي خلال 60 دقيقة ⚠"

    "صفارات الإنذار تمزق الصمت كأنها صرخة ألف إنسان يُذبحون دفعة واحدة."
    "الضوء الأحمر يغمر غرفة القيادة. رائحة الأوزون والمعدن المحترق تملأ الهواء."

    sami "(يفتح عينيه فجأة، ينتفض كمن غرق ثم سُحب من الماء.) هذا... هذا هو السقف نفسه."
    sami "(بصوت مبحوح) ثلاثون يوماً قبل الكارثة... لقد عدتُ مجدداً."

    "يتحسس رقبته. الشريحة تحت جلده تنبض بحرارة مريضة، كقلب ثانٍ لا يريده."

    sami "كم مرة؟ كم مرة سقطتُ في هذا المكان؟"
    "لا يتذكر العدد بدقة. الأرقام صارت تنزلق من بين أصابعه."

    # إدراج تأثير الجنون
    call memory_bleed

    "على الأرض بجواره، امرأة تتكئ على لوحة التحكم، يقطر الدم من جانب رأسها."

    show sara_sprite_placeholder at center
    sara "(بصوت متقطع) سامي... لا تُفعّلها مرة أخرى. أرجوك."
    sami "سارة! (يمسك كتفيها) من فعل هذا بك؟"
    sara "لا أحد... أنا فقط... (تبتسم بوهن) كنتُ أحاول تفكيك وصلة الأثير بعد أن اهتزّ المفاعل."
    sara "وعدني أنك لن تستعمل الشريحة. وعدتني."

    if loop_count > 1:
        sami "(بصوت خافت) أنتِ لا تقولين هذا لأول مرة... أليس كذلك؟"
        sara "(تشيح بوجهها) لا أعرف عمّ تتحدث."
        "ارتجاف عينيها يفضحها. هناك شيء تخفيه... شيء ثقيل."
    else:
        sami "(يشعر بغصة) سأفعل ما يلزم لإنقاذكم جميعاً."
        sara "هذا بالضبط ما أخافه."

    "تنفتح باب غرفة القيادة بعنف. يدخل رجل ضخم بزي عسكري مثقل بالأوسمة، تتبعه ظلال الجنود."

    show marshal_placeholder at right
    mohammed "قف حيث أنت يا سامي."
    mohammed "تقرير الاستشعار يقول إن الشريحة فُعّلت للتو. لا تكذب عليّ... أنا الذي ربّيتك."
    sami "يا سيدي المارشال، المفاعل..."
    mohammed "أعرف شأن المفاعل. أعرف ما هو أكثر مما تحلم به."

    "خلفه الجنرال ڤيكتور، نصفه آلة، عيناه تشعان بضوء أزرق بارد."

    victor "أي تسريب للمعلومات يعني الإعدام الفوري. هذا هو القانون."
    mohammed "ڤيكتور، أحضر الجندي."

    "يُجرّ سيلفيو من ذراعيه، وجهه شاحب، وعيناه تبحثان عن سامي."

    silvio "سامي! أقسم أنني لم أقل شيئاً لأحد! كنتُ فقط... كنتُ أتحدث مع زوجتي!"
    mohammed "سيلفيو سُرّبت منه إحداثيات القطاع السري. هذا ما تقوله السجلات."
    sami "(بيأس) هذا غير صحيح. أنا أعرف سيلفيو."
    mohammed "(ببرود) السجلات لا تكذب. ڤيكتور."

    "يرفع ڤيكتور سلاحه. قبل أن يضغط الزناد..."

    menu:
        "ما الذي يفعله سامي؟"

        "التدخل ومنع الإعدام":
            $ humanity += 5
            sami "توقف! سأتحمل المسؤولية!"
            mohammed "(يرمقه بنظرة طويلة) أنت تغيّرت يا بني."
            "ينزل ڤيكتور سلاحه ببطء، لكن نظرته تحمل وعداً بالانتقام."
            $ alive_silvio = True
            $ sara_trust += 3

        "الصمت والسماح بتنفيذ الأمر":
            $ humanity -= 8
            $ madness += 5
            sami "(يشيح بوجهه) نفّذ."
            "دوي الطلقة يقطع الهواء. جسد سيلفيو يسقط بلا صوت."
            silvio "(آخر همسة) أخبر... أخبر نعيمة... أنني..."
            $ alive_silvio = False
            call memory_bleed

    mohammed "الآن، دعنا نصل إلى الأهم."
    mohammed "المفاعل ينفجر خلال ساعة. وفق بروتوكول الأمان، لا يوجد إلا حل واحد."
    mohammed "العاملة التي ساعدتك في تصميم الشريحة يجب أن تُزال... سارة."

    sara "(تتجمد) ماذا؟"
    sami "هذا جنون!"
    mohammed "سارة هي نقطة الضعف الوحيدة. معرفتها بالشريحة تجعلها تهديداً للقبة بأكملها."
    mohammed "نفّذ الأمر بنفسك يا سامي. أو سيفعل ڤيكتور ذلك أمام عينيك."

    "تدخل الكابتن سيرين مقتحمة، عيناها تتنقلان بين سامي والمارشال."

    cyrene "سيدي المارشال، أطلب الإذن بالتحدث."
    mohammed "ليس الآن."
    cyrene "(بصوت مرتجف) كابتن سامي... هل أنت بخير؟ تقارير الاستشعار تقول إن موجات دماغك غير مستقرة."
    sami "(بسخرية مريرة) أنتِ التي ترسلين هذه التقارير للمارشال، أليس كذلك يا سيرين؟"
    cyrene "(تشحب) ماذا... كيف عرفت؟"
    sami "(يبتسم دون مرح) لأنني عشتُ هذه اللحظة من قبل."

    "الصمت يخيّم. حتى ڤيكتور يرفع حاجبه الآلي."

    # ------------------ القرار المفصلي 1 ------------------
    menu:
        "القرار المفصلي 1 — الواجب أم الحبيبة؟"

        "إطاعة المارشال محمد وإعدام سارة لتأمين المفاعل":
            jump act1_obey

        "إطلاق النار على الجيش والهروب بسارة إلى القطاع السكني":
            jump act1_flee

label act1_obey:
    $ obeyed_marshal = True
    $ humanity -= 15
    $ madness += 10
    $ sara_trust -= 40

    sami "(بصوت ميت) لا خيار آخر."
    sara "(تنظر إليه بذهول) سامي...؟"
    sami "سامحيني."

    "يسحب المسدس. يده ترتجف كأن عظامها صارت زجاجاً."

    sara "(بهدوء مخيف) افعلها. أنا أتذكر الألم أصلاً."
    sami "(يتجمد) ...ماذا قلتِ؟"
    sara "في المرة الثالثة... أحرقوني حية. في الخامسة... اختنقتُ داخل أنبوب التهوية."
    sara "لا أنتَ المخطئ ولا هم... فقط هذه الحلقة اللعينة."

    "الطلقة تُدوّي. ثم... العتمة."

    call memory_bleed

    sys_msg "الوصلة النجمية تعمل... إعادة الزمن إلى ما قبل ثلاثين يوماً."

    $ alive_sara = False
    $ loop_count += 1
    jump act2_start_loop

label act1_flee:
    $ fled_with_sara = True
    $ humanity += 12
    $ sara_trust += 20
    $ madness += 5

    sami "(يسحب سارة خلفه ويرفع سلاحه) لن يلمسها أحد."
    mohammed "(بحزن ممزوج بصلابة) هذه هي النهاية يا بني."
    victor "افتحوا النار!"

    show crack_overlay at shake_light
    "الرصاص يمزق الهواء. ينفجر زجاج الحماية. سامي يرمي قنبلة دخان ويجرّ سارة نحو ممر الصيانة."
    hide crack_overlay

    sara "(تلهث) سامي! إلى أين؟!"
    sami "القطاع السكني. ثمة ثوار هناك... لن يبحث المارشال عنا بينهم فوراً."
    sara "(تنظر إليه بذهول) ستذهب إلى ريان؟"

    "ينقطع حديثهما برصاصة تخطئ رأس سارة بعرض شعرة."

    cyrene "(من بعيد، بصوت يائس) سامي! توقف! سأغطي انسحابكما!"
    "تتبادل النظرات مع سامي لحظة واحدة... ثم تطلق النار في اتجاه ڤيكتور."

    $ alive_cyrene = True
    jump act2_start_flee

# =====================================================================
#  الفصل الثاني: تشقق الزمن والرماد
# =====================================================================
label act2_start_loop:
    scene bg dome_command
    with Dissolve(1.0)

    sys_msg "الدورة الزمنية رقم [loop_count]"
    sami "(يستيقظ والعرق يغمر جسده) ...دورة جديدة."
    call memory_bleed

    sami "سارة... (يلتفت بجانبه) أين هي؟"
    "الغرفة هادئة. بلا دماء هذه المرة. الإنذار لم يبدأ بعد."
    sami "لدي وقت. وقت كافٍ لأفعل شيئاً مختلفاً."

    jump act2_crisis

label act2_start_flee:
    scene bg residential
    with Dissolve(1.0)

    "القطاع السكني رقم 4. هواء رطب، أنابيب ملتفة، وأضواء اصطناعية تذبل."
    sara "(تستند إلى الجدار) أنت تعلم أن المارشال سيجدنا."
    sami "لن يهمني ذلك حين يكون قلبك ما زال ينبض."

    "في تلك اللحظة، تنفجر أجهزة الإنذار الخاصة بالقطاع."

    sys_msg "تسرّب إشعاعي في القطاع 4 — تحويل الأكسجين مطلوب."
    $ madness += 5
    call memory_bleed

    jump act2_crisis

label act2_crisis:
    scene bg residential

    elena "(صوت معدني محسوب) تحليل الاحتمالات: الأكسجين المتبقي يكفي لقطاع واحد فقط."
    elena "القطاع السكني للأطفال: 500 طفل. المختبرات المركزية: أبحاث سارة والبروفيسور أحمد."
    elena "احتمال نجاح إيقاف الانفجار إذا اختير القطاع السكني: 14%. إذا اختيرت المختبرات: 61%."

    sami "(بغضب) أنتِ لا تقيسين حياة البشر بالنسب!"
    elena "الاحتمالات هي كل ما أملك."

    show lena_placeholder at left
    lena "(تظهر عبر الاتصال المرئي، تسعل بشدة) أخي؟ هل سيحدث شيء سيئ؟"
    sami "لا يا لينا... سأهتم بكل شيء."
    lena "(بابتسامة صغيرة) أعرف. أنت دائماً تهتم. لكن لا تتعب نفسك كثيراً... أنا لستُ عبئاً عليك، أليس كذلك؟"
    sami "(بصوت مختنق) أنتِ عالمي كله."

    # ------------------ القرار المفصلي 2 ------------------
    menu:
        "القرار المفصلي 2 — الأطفال أم الأبحاث؟"

        "تحويل الأكسجين لقطاع الأطفال والأخت لينا":
            $ oxygen_to_children = True
            $ humanity += 15
            $ madness += 3
            sami "أنقذوا الأطفال. هذا هو القرار."
            elena "تم. احتمال نجاح إيقاف الانفجار انخفض إلى 14%."
            ahmad "(عبر الاتصال، بصوت مرتعش) أتعلم ما فعلتَه للتو؟ لقد حكمتَ على أبحاثنا بالموت!"
            sami "وأنت حكمتَ على خمسمئة طفل بالموت لو كنتُ اخترتُ غير ذلك."
            "في المختبرات، يتوقف الهواء. صراخ مكتوم يتبعه سكون."
            sara "(تبكي بصمت) كان هناك زملاء لي في المختبر..."
            $ sara_trust -= 5

        "تحويل الأكسجين للمختبرات المركزية":
            $ oxygen_to_labs = True
            $ humanity -= 20
            $ madness += 12
            $ alive_lena = False
            sami "(بصوت متحجر) المختبرات. نفذي."
            elena "تم. احتمال النجاح 61%."
            lena "(صوتها يتلاشى) أخي؟ لماذا أشعر بالبرد...؟"
            sami "لينا! (يصرخ) لينا!"
            "الشاشة تنطفئ. صمت. ثم همس معدني بارد."
            elena "سامي، أنت اتخذتَ الخيار الأمثل."
            sami "(بحقد) اخرسي."
            call memory_bleed
            call memory_bleed

    "الأنوار تومض. الوقت ينفد. هناك شيء ينتظره في الخلاء الميت."
    jump act3

# =====================================================================
#  الفصل الثالث: انقسام المصائر والجنون
# =====================================================================
label act3:
    scene bg wasteland
    with Dissolve(1.0)

    $ loop_count = max(loop_count, 5)
    sys_msg "الدورة الزمنية رقم 5 — حالة الجنون: [madness]%"

    "الخلاء الميت. عاصفة أثيرية تعوي فوق أنقاض مدينة لم يعد لها اسم."
    sami "(يرتدي بذلة الحماية، أنفاسه ثقيلة) لماذا جئتُ إلى هنا؟"

    call memory_bleed

    whisper "لأنك تبحث عن الجواب... وعن الذي يستحق اللوم."

    "ظل طويل ينبثق من وسط الغبار، يرتدي بذلة سوداء ممزقة، وجهه مغطى بنقوش نيون سوداء."

    shadow "(بصوت يشبه صوت سامي لكنه أجش) تأخرتَ يا سامي."
    sami "(يشهر سلاحه) من أنت؟"
    shadow "(بخفوت) أنا الذي تخشى أن تصير إليه."

    "ينتزع الغريب قناعه. وجهه... وجه سامي نفسه، لكن منخور بآلاف السنين من العذاب."

    shadow "عشتُ عشرة آلاف دورة. وفشلتُ في كل واحدة."
    sami "(يتراجع) هذا مستحيل..."
    shadow "ثمة سر كنتُ أحمله منذ زمن: سارة تتذكر كل ألم. كل موت. كل حرق."
    sami "(بصوت مكسور) كاذب!"
    shadow "اسألها. لم تخبرك لأنها تحبك."

    if not shadow_revealed:
        "في هذه اللحظة، يظهر خلف الظل شخص آخر... رجل ملثّم يحمل راية ثوار الأنقاض."
        ryan "(يصفّق ببطء) هل أنهيتما حفلة اللقاء؟"
        sami "ريان..."
        ryan "كنت أعرف أنك ستعود يا صديقي. لكن لا تتوقع مني العفو."

    "قبل أن يتمكن سامي من الرد، يقترب الظل منه ويهمس:"
    shadow "اسمي الحقيقي ليس سراً بيننا. اسمي... محمود."

    $ shadow_name = "محمود"
    $ shadow_revealed = True
    $ madness += 8
    call memory_bleed

    sami "(مذهولاً) محمود...؟ الاسم الذي أردتُ أن أنساه منذ طفولتي..."
    shadow "هذا هو اسمك قبل أن تنسى من أنت."

    "تتلاشى العاصفة، ويعود سامي إلى القبة. الوقت يضيق، والمفاعل ينبض كوحش على وشك الانفجار."

    scene bg reactor
    with Dissolve(1.0)

    "غرفة المفاعل. أضواء بنفسجية تتراقص على الجدران. سارة تقف في المنتصف، مسدس مصوّب نحو رأسها."

    sara "(بصوت يرتجف لكن حازم) توقف عندك يا سامي."
    sami "(يرفع يديه ببطء) سارة... ضعي السلاح."
    sara "لا. أنا أعرف ما هو آت. رأيتُ كل هذا مئات المرات."
    sara "(تبكي) أنا أحس بالنار على جلدي كل ليلة. أسمع صراخي وأنا أختنق. هل تعلم كم هذا مؤلم؟"

    if sara_trust >= 60:
        sami "(بصوت مخنوق) لماذا لم تخبريني؟"
        sara "لأنك كنتَ تحتاج أن تظن أنني بخير."
    elif sara_trust <= 20:
        sami "(بمرارة) لقد تخليتُ عنك في الحلقات السابقة، أليس كذلك؟"
        sara "(بنظرة جامدة) أكثر مما تتصور."
    else:
        sami "(بتعب) كنتِ ستفعلين الشيء نفسه."
        sara "ربما."

    sara "إن لم تتركني أموت الآن، سأطلق النار على المفاعل بنفسي!"

    # ------------------ القرار المفصلي 3 ------------------
    menu:
        "القرار المفصلي 3 — إنقاذ سارة أم احترام رغبتها؟"

        "السيطرة عليها بالقوة وزرع عقار النسيان في دماغها":
            $ sara_memory_wiped = True
            $ sara_trust -= 40
            $ humanity -= 10
            $ madness += 8
            sami "(بهدوء مخيف) آسف، لكنني لن أخسرك."
            sara "سامي، لا... لا تفعل!"
            "يقفز نحوها، ينتزع المسدس، ويغرس حقنة بيضاء في رقبتها."
            sara "(تتهاوى) أنت... وحش..."
            "تفتح عينيها بعد لحظات. نظرتها فارغة تماماً، كآلة أُعيد ضبطها."
            sara "(بصوت محايد) مرحباً. ما اسمك؟"
            sami "(يحدق بها بصمت، والدموع تنزف) ...اسمي سامي."
            call memory_bleed

        "احترام رغبتها وتركها تموت":
            $ sara_left_to_die = True
            $ alive_sara = False
            $ madness += 20
            $ humanity += 3
            sami "(بصوت مكسور) لن أمنعكِ."
            sara "(تبتسم بين دموعها) شكراً."
            "تضغط الزناد. دوي الطلقة يتردد في أرجاء المفاعل مثل صرخة كونية."
            sami "(يسقط على ركبتيه) ...ليس مرة أخرى."
            call memory_bleed
            call memory_bleed
            whisper "لقد تركتها تموت... وكنتَ تعلم."

    jump act4

# =====================================================================
#  الفصل الرابع: بروتوكول الصفر وسقوط العرش
# =====================================================================
label act4:
    scene bg reactor
    with Dissolve(1.0)

    sys_msg "الوصول إلى النواة المركزية — الجميع حاضر."

    "المفاعل يعلو في السماء كنجم أسود. من كل الأبواب يتدفق الجميع."
    "الجيش بقيادة المارشال محمد... ثوار الأنقاض بقيادة ريان... والظل الذي صار اسمه [shadow_name]."

    mohammed "سامي! أنزل سلاحك فوراً!"
    ryan "لا تستمع إليه! هذه فرصتنا لهدم القبة!"
    shadow "لقد جئتَ إلى هنا لتنهي هذا العذاب. لا تتردد."
    elena "(بنبرة هادئة) أحتاج منك قراراً خلال ستين ثانية."

    "ثلاثة أبواب أمام سامي... ثلاثة مصائر."

    menu:
        "القرار الأخير — ما الذي يختاره سامي؟"

        "اختراق خوادم إيلينا وكشف الحقيقة عن الشريحة":
            $ hacked_elena = True
            $ humanity += 10
            sami "(يدخل رمز الاختراق) إيلينا... أريد أن أعرف الحقيقة."
            elena "(بصوت يتلاشى) ...الشريحة هي من تسحب الأثير. وأنت من تسبب في الانهيار الكوانتي."
            "وجه سامي يبهت. كل شيء يتضح."

        "التحالف مع محمود وريان وتفجير المفاعل":
            $ allied_shadow = True
            $ allied_ryan = True
            $ humanity -= 25
            $ madness += 15
            sami "(بصوت بارد) هذه القبة لا تستحق البقاء."
            shadow "هذا ما كنتُ أنتظره."
            ryan "(بحماس مجنون) إذن لنحرقها!"

        "رفض أي تضحية والتمسك بالحلقة":
            $ refused_sacrifice = True
            $ madness += 20
            sami "لن أترك أحداً يموت. لا هذه المرة. ولا أي مرة."
            shadow "(بحزن) هذا ما قلته في الحلقة الأولى."

        "تدمير المفاعل يدوياً دون إعادة الزمن":
            $ destroyed_manually = True
            $ humanity += 5
            sami "(يمسك ذراع الفصل اليدوي) سنبني من الرماد."
            mohammed "(بشحوب) أنت تقتل نصفنا!"
            sami "أنا أعرف."

    jump ending_check

# =====================================================================
#  حساب النهاية
# =====================================================================
label ending_check:
    scene bg black
    with Dissolve(1.5)

    if allied_shadow and allied_ryan:
        jump ending_extinction
    elif humanity > 80 and hacked_elena:
        jump ending_self_erase
    elif madness > 80 and refused_sacrifice:
        jump ending_eternal_loop
    elif destroyed_manually:
        jump ending_bitter
    elif humanity >= madness:
        jump ending_bitter
    else:
        jump ending_eternal_loop

# ---------------------------------------------------------------------
label ending_self_erase:
    centered "{size=+8}نهاية «الشهيد المنسي»{/size}"
    "ينتزع سامي الشريحة بيديه. الدم يتناثر. النور يبتلع كل شيء."
    "يتلاشى اسمه من الذاكرة. يشرق صباح جديد على قبة هادئة."
    "سارة تضحك مع رجل آخر. المارشال محمد يتقاعد. لينا تركض في الحدائق."
    "ولا أحد يتذكر أنه كان يوماً شخص اسمه سامي."
    centered "— النهاية الأولى —"
    return

label ending_eternal_loop:
    centered "{size=+8}نهاية «الحلقة الملعونة»{/size}"
    "يفعّل سامي الوصلة النجمية للمرة العشرة آلاف."
    "جسده يتحول إلى كتلة سوداء. سارة تتجمد تمثالاً أثيرياً."
    "الإنذار يرن مجدداً. سامي يفتح عينيه على السقف نفسه."
    "ولا مخرج."
    centered "— النهاية الثانية —"
    return

label ending_extinction:
    centered "{size=+8}نهاية «سقوط العرش والرماد»{/size}"
    "يرفع سامي التغذية الأثيرية إلى 1000%. المفاعل يصرخ."
    "القبة، الزمن، الخلاء... كل شيء يتحول إلى ضوء أبيض."
    "ثم صمت. صمت أبدي."
    centered "— النهاية الثالثة —"
    return

label ending_bitter:
    centered "{size=+8}نهاية «القبول المؤلم»{/size}"
    "ينهار المفاعل. القبة تتشقق وتتهاوى. نصف السكان يموتون، من بينهم من أحب."
    "يخرج سامي مع الناجين إلى الخلاء الميت، يمسك بيد ما تبقى له من العالم."
    "الإشعاع يحرق، لكن الأمل يتنفس أخيراً."
    "حضارة جديدة تبدأ بين الأنقاض... بلا زمن مجزأ، وبلا أكاذيب."
    centered "— النهاية الرابعة —"
    return
